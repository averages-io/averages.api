{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolagy-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Backs "Sync Across Devices" plus the Projected-GPA history behind the
  // weekly-report email's "vs last week" line — see src/sync.ts. Namespace
  // created 2026-09-08 via `npx wrangler kv namespace create SYNC_KV`.
  "kv_namespaces": [
    { "binding": "SYNC_KV", "id": "68503ced5e4d4a25ab14f85d98084cd2" }
  ]
  // Allowed CORS origins and the session cookie's domain are hardcoded as
  // ALLOWED_ORIGINS/COOKIE_DOMAIN constants in src/index.ts (schoolagy.io
  // only, as of 2026-09-08 — a brief sch00lagy.com second-domain fallback
  // was removed; see index.ts's own comment for why) rather than living
  // here as wrangler vars — one less place to keep in sync.
  //
  // SESSION_SECRET is NOT set here — it is a secret, not a var.
  // Set it once with:  npx wrangler secret put SESSION_SECRET
}
