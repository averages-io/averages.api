{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "averages-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "vars": {
    "GOOGLE_CLIENT_ID": "362414855541-vfn2l907f3b8sm3h81nhja0ehr9pln29.apps.googleusercontent.com",
    "CANVA_CLIENT_ID": "OC-AaDPpElswNe6",
    "GOOGLE_REDIRECT_URI": "https://api.averages.io/auth/google/callback",
    "CANVA_REDIRECT_URI": "https://api.averages.io/canva/callback",
    "MS_CLIENT_ID": "c006202b-180f-4d4c-b03c-c0f43048c8e9",
    "CANVA_EXPORT_ENABLED": "1",
    "CANVA_FOLDERS_ENABLED": "1",
    "CANVA_PERMISSION_PROBE": "0",
    // 1 = Fullscreen for everyone (while the fullscreen switch is on); 0 = only app.schoology.com sign-ins and API keys.
    "FULLSCREEN_PUBLIC": "1",
    "VAPID_PUBLIC_KEY": "BOiujaTWwvcGdegG6HdCOCkyuYqKK-WgOMx8HAde1XZP4jN9wPfnDvjlLdjOFKNImJWzR3GHRf8vvsAmVZXyGg0"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SYNC", "class_name": "SyncStore" },
      { "name": "CANVA", "class_name": "CanvaStore" },
      { "name": "PUSH", "class_name": "PushStore" },
      { "name": "CLOUD", "class_name": "CloudStore" },
      // Averages Plus (src/billing.ts): Stripe customer / subscription per student, US jurisdiction.
      { "name": "BILLING", "class_name": "BillingStore" },
      // Calendar sync, an Averages Plus perk (src/calendar.ts, 2026-10-21): one per student link and one per feed, US jurisdiction.
      { "name": "CALENDAR", "class_name": "CalendarStore" },
      // The automatic outage check (src/health.ts, 2026-11-10): one record for the whole app, US jurisdiction.
      { "name": "HEALTH", "class_name": "HealthStore" }
    ]
  },
  "flagship": [{ "binding": "FLAGS", "app_id": "005ce593-1d7c-4a30-80f9-18f7efe7f20d" }],
  // "Verify your email" codes (2026-11-06, src/emailCode.ts): Cloudflare Email Service, from averages.io only.
  // averages.io must be onboarded once in the dashboard: Compute > Email Service > Email Sending > Onboard Domain.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@averages.io"] }],
  "ratelimits": [
    { "name": "RATE_LIMIT_SIGNIN", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RATE_LIMIT_DATA", "namespace_id": "1002", "simple": { "limit": 90, "period": 60 } },
    { "name": "RATE_LIMIT_SEND", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_SUBMIT", "namespace_id": "1004", "simple": { "limit": 90, "period": 60 } },
    { "name": "RATE_LIMIT_PUSH", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
    { "name": "RATE_LIMIT_CANVA", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } },
    { "name": "RATE_LIMIT_CANVA_POLL", "namespace_id": "1007", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMIT_CANVA_BROWSE", "namespace_id": "1008", "simple": { "limit": 90, "period": 60 } },
    { "name": "RATE_LIMIT_APPLY", "namespace_id": "1009", "simple": { "limit": 3, "period": 60 } },
    { "name": "RATE_LIMIT_APPLY_CODE", "namespace_id": "1010", "simple": { "limit": 3, "period": 60 } },
    { "name": "RATE_LIMIT_APPLY_VERIFY", "namespace_id": "1011", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_CLOUD", "namespace_id": "1012", "simple": { "limit": 60, "period": 60 } },
    { "name": "RATE_LIMIT_MEDIA", "namespace_id": "1013", "simple": { "limit": 20, "period": 60 } },
    { "name": "RATE_LIMIT_BILLING", "namespace_id": "1014", "simple": { "limit": 20, "period": 60 } }
  ],
  // No containers (2026-11-03): the Word converter for Canva Docs is gone (Martin: "we don't need a container for
  // canva exports"); migration v10 below deletes its Durable Object class.
  // Queues are parked for launch (scope-and-priorities.md, 2026-10-16): no real
  // users yet, so nothing to retry and nobody saving folders to Canva. The code
  // in src/retryQueue.ts + src/canvaSave.ts stays and no-ops without the RETRY
  // binding (enqueueRetry returns false; the `queue` export is never invoked).
  // To switch back on later: uncomment, then `npx wrangler queues create averages-retry`.
  // "queues": {
  //   "producers": [{ "binding": "RETRY", "queue": "averages-retry" }],
  //   "consumers": [{ "queue": "averages-retry", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 8 }]
  // },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "averages-media", "jurisdiction": "us" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyncStore"] },
    { "tag": "v2", "new_sqlite_classes": ["CanvaStore"] },
    { "tag": "v3", "new_sqlite_classes": ["PushStore"] },
    { "tag": "v4", "new_sqlite_classes": ["SchoolsStore"] },
    { "tag": "v5", "new_sqlite_classes": ["CloudStore"] },
    { "tag": "v6", "new_sqlite_classes": ["Converter"] },
    { "tag": "v7", "deleted_classes": ["SchoolsStore"] },
    { "tag": "v8", "new_sqlite_classes": ["BillingStore"] },
    { "tag": "v9", "new_sqlite_classes": ["CalendarStore"] },
    { "tag": "v10", "deleted_classes": ["Converter"] },
    { "tag": "v11", "new_sqlite_classes": ["HealthStore"] }
  ],
  // Every 15 minutes: the automatic outage check (src/health.ts). Martin, 2026-11-10: "auto refresh on the server every 15 min".
  "triggers": { "crons": ["*/15 * * * *"] }
}
